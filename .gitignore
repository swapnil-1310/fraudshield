# ==============================================================================
# FinGuard — Git Ignore Configuration
# ==============================================================================

# Environment & Secrets (Never commit live credentials)
.env
*.env
.env.*
!.env.example

# Python Virtual Environments
.venv/
env/
venv/
ENV/
*.venv/

# Compiled Bytecode & Caches
__pycache__/
*.py[cod]
*$py.class
*.log
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Machine Learning Checkpoints & Model Weights (Download dynamically)
*.pth
*.pt
*.bin
*.safetensors
*.onnx
*.tflite

# Ephemeral Runtime Scratchpads (Preserve directory structure)
temp/*
!temp/.gitkeep

# Evaluation Benchmark Dumps & Datasets
dataset/
tests/*.csv
*.csv.bak

# IDE, OS & System Metadata
.DS_Store
Thumbs.db
.vscode/
.idea/
